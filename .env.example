# Gemini API key (AI chat & quiz)
GEMINI_API_KEY=your_gemini_api_key

# Gmail notification (contact form)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_RECEIVER=your_email@gmail.com

# Flask app
# Use a random long string (e.g. python -c "import secrets; print(secrets.token_hex(24))")
SECRET_KEY=change-me-in-production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Admin setup (run create_admin.py)
ADMIN_FULLNAME=Admin
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password